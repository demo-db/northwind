  "views": [
    {
      "name": "Alphabetical list of products",
      "status": "source-definition-only",
      "columns": [
        "ProductID",
        "ProductName",
        "SupplierID",
        "CategoryID",
        "QuantityPerUnit",
        "UnitPrice",
        "UnitsInStock",
        "UnitsOnOrder",
        "ReorderLevel",
        "Discontinued",
        "CategoryName"
      ],
      "sourceSql": "CREATE VIEW [Alphabetical list of products] \r\nAS\r\nSELECT Products.*, \r\n       Categories.CategoryName\r\nFROM Categories \r\n   INNER JOIN Products ON Categories.CategoryID = Products.CategoryID\r\nWHERE (((Products.Discontinued)=0))"
    },
    {
      "name": "Category Sales for 1997",
      "status": "source-definition-only",
      "columns": [
        "CategoryName",
        "CategorySales"
      ],
      "sourceSql": "CREATE VIEW [Category Sales for 1997] AS\r\nSELECT     [Product Sales for 1997].CategoryName, \r\n       Sum([Product Sales for 1997].ProductSales) AS CategorySales\r\nFROM [Product Sales for 1997]\r\nGROUP BY [Product Sales for 1997].CategoryName"
    },
    {
      "name": "Current Product List",
      "status": "source-definition-only",
      "columns": [
        "ProductID",
        "ProductName"
      ],
      "sourceSql": "CREATE VIEW [Current Product List] \r\nAS\r\nSELECT ProductID,\r\n       ProductName \r\nFROM Products \r\nWHERE Discontinued=0"
    },
    {
      "name": "Customer and Suppliers by City",
      "status": "source-definition-only",
      "columns": [
        "City",
        "CompanyName",
        "ContactName",
        "Relationship"
      ],
      "sourceSql": "CREATE VIEW [Customer and Suppliers by City] \r\nAS\r\nSELECT City, \r\n       CompanyName, \r\n       ContactName, \r\n       'Customers' AS Relationship \r\nFROM Customers\r\nUNION \r\nSELECT City, \r\n       CompanyName, \r\n       ContactName, \r\n       'Suppliers'\r\nFROM Suppliers \r\nORDER BY City, CompanyName"
    },
